# ==========================================
# OpportunityShield AI - Environment Configuration
# ==========================================

# SerpApi API Key (Get your free key at https://serpapi.com - 250 free searches/month per hackathon terms)
# When set, live multi-engine queries (Google Search, News, Jobs) are performed.
# Benchmark demonstrations remain accessible as an explicit separate testing feature.
SERPAPI_KEY=

# Server Configuration
PORT=5000
FLASK_DEBUG=0
# Optional: Set a persistent production secret key (if omitted, a cryptographically secure key is generated)
SECRET_KEY=

# SerpApi Engine Query Limits (Optimizes credits)
SERPAPI_MAX_ORGANIC_RESULTS=8
SERPAPI_MAX_NEWS_RESULTS=6
SERPAPI_MAX_JOBS_RESULTS=6
SERPAPI_TIMEOUT_SECONDS=12

